<?xml version="1.0" encoding="utf-8"?>

<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F4F7FA"
    android:paddingStart="24dp"
    android:paddingEnd="24dp"
    android:paddingTop="28dp"
    android:paddingBottom="24dp">

    <!-- TITLE -->

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Emergency Message"
        android:textColor="#0A2239"
        android:textSize="27sp"
        android:textStyle="bold"
        android:letterSpacing="0.01" />

    <!-- SUBTITLE -->

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="7dp"
        android:text="Add more information to your emergency alert."
        android:textColor="#667085"
        android:textSize="14sp"
        android:lineSpacingExtra="2dp" />


    <!-- MESSAGE INPUT -->

    <com.google.android.material.textfield.TextInputLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="28dp"
        android:hint="Describe your situation"
        app:boxBackgroundMode="outline"
        app:boxBackgroundColor="#FFFFFF"
        app:boxCornerRadiusTopStart="14dp"
        app:boxCornerRadiusTopEnd="14dp"
        app:boxCornerRadiusBottomStart="14dp"
        app:boxCornerRadiusBottomEnd="14dp"
        app:boxStrokeColor="#0A2239"
        app:boxStrokeWidth="1dp"
        app:boxStrokeWidthFocused="2dp"
        app:hintTextColor="#667085">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/etMessage"
            android:layout_width="match_parent"
            android:layout_height="160dp"
            android:gravity="top|start"
            android:inputType="textMultiLine"
            android:maxLines="6"
            android:padding="16dp"
            android:textColor="#101828"
            android:textSize="15sp" />

    </com.google.android.material.textfield.TextInputLayout>


    <!-- LOCATION -->

    <TextView
        android:id="@+id/tvLocationStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:background="#EAF2F8"
        android:padding="14dp"
        android:text="📍  Your location will be attached"
        android:textColor="#344054"
        android:textSize="14sp"
        android:textStyle="bold" />


    <!-- SEND BUTTON -->

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnSendMessage"
        android:layout_width="match_parent"
        android:layout_height="54dp"
        android:layout_marginTop="22dp"
        android:text="Send Emergency Message"
        android:textAllCaps="false"
        android:textColor="#FFFFFF"
        android:textSize="15sp"
        android:textStyle="bold"
        android:elevation="4dp"
        app:backgroundTint="#D92D20"
        app:cornerRadius="14dp"
        app:rippleColor="#55FFFFFF" />

</LinearLayout>